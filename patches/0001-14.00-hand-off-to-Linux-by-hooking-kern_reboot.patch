From 069102018c47e79007d3cc1229e988bd211292e3 Mon Sep 17 00:00:00 2001
From: mexht <maximilian.tesik@gmx.at>
Date: Wed, 4 Nov 2026 19:06:54 +0100
Subject: [PATCH 1/2] 14.00: hand off to Linux by hooking kern_reboot

sys_reboot() on 14.00 never reaches icc_query_nowait, so the ICC hook only
fires for the shell-orchestrated shutdown (the power menu). Every
evf_cancel/evf_set/kill(1, SIGUSR1) variant either wedges the console or
stalls at white LED with the Orbis kernel still alive.

kern_reboot is on every reboot path, so hook it as well and call it from
kernel context inside sys_kexec:

  -DHOOK_KERN_REBOOT   install hook_kern_reboot() (wlanbt, fix_acpi_tables,
                       smp_rendezvous(cpu_quiesce_gate)), record success in
                       kern_reboot_hooked
  -DAUTO_TRIGGER=0x0  call kern.kern_reboot() right after arming, but only
                       if the hook installed

One raw .bin then boots Linux with no shutdown, no evf, no kill(1) and no
power-menu step.

Also:
- diag(): durable tag=value lines on /mnt/usb0 (fallback /data/linux),
  fsync'd per line, because a frozen hand-off never reaches close() and the
  page cache used to be lost.
- -DNO_REBOOT_WATCHDOG: the legacy reboot_thread fires the broken
  evf_cancel(0x4000)+kill(1) trigger one second after arming; with
  AUTO_TRIGGER it is dead code, without it kills the console.

Reconstruction of the 2026-11-03 commits (53123cd, 308d85c) after the
original working tree was lost with /tmp.
---
 linux/main-aio.c                    | 70 +++++++++++++++++++++++++++--
 linux/ps4-kexec-common/kexec.c      | 38 +++++++++++++---
 linux/ps4-kexec-common/linux_boot.c | 27 +++++++++++
 linux/ps4-kexec-common/linux_boot.h |  4 ++
 4 files changed, 131 insertions(+), 8 deletions(-)

diff --git a/linux/main-aio.c b/linux/main-aio.c
index 7bd9261..0c96530 100644
--- a/linux/main-aio.c
+++ b/linux/main-aio.c
@@ -49,6 +49,57 @@ static void log_msg(const char *msg)
         write(1, "\n", 1);
 }
 
+/*
+ * diag() — durable one-line telemetry for hand-off debugging.
+ *
+ * Writes tag=value to the boot USB (FAT) and, if that is not mounted, to the
+ * internal disk. Every line is fsync'd: a hand-off that freezes never reaches
+ * close(), and without the sync the page cache is lost and the post-mortem
+ * file comes back empty.
+ */
+static int diag_fd = -2;
+
+static void diag_num(char *b, int *n, unsigned long long v)
+{
+    char t[24];
+    int m = 0;
+
+    if (!v)
+        t[m++] = '0';
+    while (v) {
+        t[m++] = (char)('0' + (v % 10));
+        v /= 10;
+    }
+    while (m)
+        b[(*n)++] = t[--m];
+}
+
+static void diag(const char *tag, unsigned long long v)
+{
+    char b[96];
+    int n = 0;
+
+    if (diag_fd == -2) {
+        diag_fd = open("/mnt/usb0/ps4linux-diag.txt",
+                       O_WRONLY | O_CREAT | O_TRUNC, 0666);
+        if (diag_fd < 0)
+            diag_fd = open("/data/linux/ps4linux-diag.txt",
+                           O_WRONLY | O_CREAT | O_TRUNC, 0666);
+    }
+
+    while (*tag && n < 60)
+        b[n++] = *tag++;
+    b[n++] = '=';
+    diag_num(b, &n, v);
+    b[n++] = '\n';
+
+    if (diag_fd >= 0) {
+        write(diag_fd, b, n);
+        fsync(diag_fd);
+    }
+    log_msg(b);
+}
+
 // Universal kexec blobs
 asm("kexec_505:\n.incbin \"kexec-build/505/kexec.bin\"\nkexec_505_end:\n");
 asm("kexec_672:\n.incbin \"kexec-build/672/kexec.bin\"\nkexec_672_end:\n");
@@ -353,6 +404,7 @@ int main(void)
     // Firmware detection and blob selection
     u16 fw_ver = get_firmware();
     u16 norm   = normalize_fw_ver(fw_ver);
+    diag("fw", fw_ver);
 
     g_fw = find_offsets_by_fw(norm);
     if (!g_fw) {
@@ -411,8 +463,16 @@ int main(void)
     }
 
     // Launch kernel exploit → kernel_main()
+    diag("pre_kexec", kernel_size);
     kexec(kernel_main, (void *)0);
-
+    diag("post_kexec", 0);
+
+#ifdef NO_REBOOT_WATCHDOG
+    /* 14.00: the watchdog fires the broken evf_cancel(0x4000)+kill(1) trigger
+     * one second after arming. With AUTO_TRIGGER it is dead code; without it,
+     * it turns "payload did nothing" into a dead console. Leave it out. */
+    diag("watchdog", 0);
+#else
     // Launch reboot watchdog thread, then Linux loader
     long x, y;
     struct thr_param thr = {
@@ -429,7 +489,11 @@ int main(void)
         .rtp        = NULL,
     };
     thr_new(&thr, sizeof(thr));
-    kexec_load(kernel, kernel_size, initrd, initrd_size, cmdline,
-               pack_kexec_args(vram_mb, fw_ver, sb_val));
+    diag("watchdog", 1);
+#endif
+
+    int rc = kexec_load(kernel, kernel_size, initrd, initrd_size, cmdline,
+                        pack_kexec_args(vram_mb, fw_ver, sb_val));
+    diag("kexec_load_rc", (unsigned long long)(long)rc);
     for (;;);
 }
diff --git a/linux/ps4-kexec-common/kexec.c b/linux/ps4-kexec-common/kexec.c
index 0c4c3b8..15e34e8 100644
--- a/linux/ps4-kexec-common/kexec.c
+++ b/linux/ps4-kexec-common/kexec.c
@@ -249,11 +249,39 @@ int sys_kexec(void *td, struct sys_kexec_args *uap)
     kern.printf("kexec successfully armed. Please shut down the system.\n");
     kern.printf("******************************************************\n\n");
 
-/*
-    kern.printf("\nkern_reboot(0x%x)...\n", RB_POWEROFF);
-    if (kern.kern_reboot(RB_POWEROFF) == -1)
-        kern.printf("\nkern_reboot(0x%x) failed\n", RB_POWEROFF);
-*/
+#ifdef HOOK_KERN_REBOOT
+    /*
+     * 14.00: sys_reboot() never reaches icc_query_nowait -- only the
+     * shell-orchestrated shutdown (the power menu) does. Every
+     * evf_cancel/evf_set/kill(1, SIGUSR1) variant therefore either wedges
+     * the console or stalls at a white LED with the Orbis kernel still
+     * alive. kern_reboot is on *every* reboot path, so hook that too.
+     */
+    if (!kernel_hook_install(hook_kern_reboot, kern.kern_reboot)) {
+        kern.printf("Failed to install kern_reboot hook\n");
+    } else {
+        kern.printf("DIAG kern_reboot hook installed at %p\n",
+                    kern.kern_reboot);
+        kern_reboot_hooked = 1;
+    }
+#endif
+
+#ifdef AUTO_TRIGGER
+    /*
+     * Fire the hand-off from kernel context, right after arming, instead of
+     * waiting for userland to notice. Only do it when the hook is really
+     * installed; otherwise the console would just be shut down.
+     */
+    if (kern_reboot_hooked) {
+        kern.printf("AUTO_TRIGGER: calling kern_reboot(0x%x) from kernel context\n",
+                    (int)AUTO_TRIGGER);
+        int rr = kern.kern_reboot((int)AUTO_TRIGGER);
+        kern.printf("AUTO_TRIGGER: kern_reboot returned %d\n", rr);
+    } else {
+        kern.printf("AUTO_TRIGGER: skipped (kern_reboot hook not installed)\n");
+    }
+#endif
+
     return 0;
 
 cleanup:
diff --git a/linux/ps4-kexec-common/linux_boot.c b/linux/ps4-kexec-common/linux_boot.c
index 7ae93a1..885722f 100644
--- a/linux/ps4-kexec-common/linux_boot.c
+++ b/linux/ps4-kexec-common/linux_boot.c
@@ -472,3 +472,30 @@ int hook_icc_query_nowait(u8 *icc_msg)
     kern.printf("hook_icc_query_nowait: unreachable (?)\n");
     return 0;
 }
+
+/*
+ * 14.00: kern_reboot is on every reboot path (sys_reboot never reaches
+ * icc_query_nowait), so hooking it makes the hand-off independent of the
+ * shell, the power menu and userland entirely.
+ */
+int kern_reboot_hooked;
+
+int hook_kern_reboot(int magic)
+{
+    kern.printf("hook_kern_reboot called (magic=0x%x)\n", magic);
+
+    // We need reset bt/wifi, so disable it, we re-enable it when the kernel boot
+    kern.wlanbt(0x2);
+    kern.printf("DIAG kern_reboot hook: wlanbt disabled\n");
+
+    fix_acpi_tables((void*)PA_TO_DM(0xe0000), 0xe0000);
+    kern.printf("DIAG kern_reboot hook: ACPI tables fixed\n");
+
+    // Same transition as the ICC hook: halt the secondaries, never return.
+    kern.smp_rendezvous(kern.smp_no_rendevous_barrier,
+                        cpu_quiesce_gate,
+                        kern.smp_no_rendevous_barrier, NULL);
+
+    kern.printf("hook_kern_reboot: unreachable (?)\n");
+    return 0;
+}
diff --git a/linux/ps4-kexec-common/linux_boot.h b/linux/ps4-kexec-common/linux_boot.h
index 2232b35..04ce0b6 100644
--- a/linux/ps4-kexec-common/linux_boot.h
+++ b/linux/ps4-kexec-common/linux_boot.h
@@ -85,4 +85,8 @@ void set_nix_info(void *linux_image, struct boot_params *bp, void *initramfs,
 void prepare_boot_params(struct boot_params *bp, u8 *linux_image);
 int hook_icc_query_nowait(u8 *icc_msg);
 
+/* 14.00: second hook, on the function every reboot path reaches. */
+int hook_kern_reboot(int magic);
+extern int kern_reboot_hooked;
+
 #endif
